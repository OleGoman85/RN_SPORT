# Server
# Used by Express to choose the local backend port.
# FrontEnd EXPO_PUBLIC_API_URL should point to this port.
PORT=5001

# Neon Postgres database
# Used to store app data: users, profiles, sports, events, and event members.
# Get it from https://console.neon.tech -> your project -> Connection details.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Upstash Redis REST API
# Used by the backend rate limiter to limit too many requests from the same IP.
# Get both from https://console.upstash.com -> your Redis database -> REST API.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Cloudinary
# Used to upload and host user avatar images.
# Get these from https://console.cloudinary.com -> Dashboard / API Keys.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
