# Clerk
# Used by the Expo app for authentication: sign up, sign in, and current user session.
# This is a public frontend key, not a secret backend key.
# Get it from https://dashboard.clerk.com -> your application -> API keys.
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=

# Backend API
# Used by the Expo app as the base URL for all backend requests.
# Local example: use the LAN IP of the computer running BackEnd.
# EXPO_PUBLIC_ variables are bundled into the app, so do not put secrets here.
EXPO_PUBLIC_API_URL=http://192.168.32.127:5001
